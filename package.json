{
  "name": "@evmnow/sdk",
  "version": "0.7.0",
  "description": "Resolve complete contract metadata for any EVM contract — curated repository, ERC-7572 contractURI, Sourcify + NatSpec, and proxy/diamond resolution — merged into a single document.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evmnow/sdk.git"
  },
  "keywords": [
    "ethereum",
    "evm",
    "contract-metadata",
    "sourcify",
    "natspec",
    "abi",
    "erc-7572",
    "erc-2535",
    "proxy",
    "diamond"
  ],
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "import": "./dist/actions.js"
    },
    "./merge": {
      "types": "./dist/merge.d.ts",
      "import": "./dist/merge.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    },
    "./natspec": {
      "types": "./dist/natspec.d.ts",
      "import": "./dist/natspec.js"
    },
    "./token": {
      "types": "./dist/token.d.ts",
      "import": "./dist/token.js"
    },
    "./intent": {
      "types": "./dist/intent.d.ts",
      "import": "./dist/intent.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.js"
    },
    "./uri": {
      "types": "./dist/uri.d.ts",
      "import": "./dist/uri.js"
    },
    "./ens": {
      "types": "./dist/ens.d.ts",
      "import": "./dist/ens.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./interfaces/detect": {
      "types": "./dist/interfaces/detect.d.ts",
      "import": "./dist/interfaces/detect.js"
    },
    "./interfaces/erc20": {
      "types": "./dist/interfaces/erc20.d.ts",
      "import": "./dist/interfaces/erc20.js"
    },
    "./interfaces/erc721": {
      "types": "./dist/interfaces/erc721.d.ts",
      "import": "./dist/interfaces/erc721.js"
    },
    "./sources/repository": {
      "types": "./dist/sources/repository.d.ts",
      "import": "./dist/sources/repository.js"
    },
    "./sources/contract-uri": {
      "types": "./dist/sources/contract-uri.d.ts",
      "import": "./dist/sources/contract-uri.js"
    },
    "./sources/sourcify": {
      "types": "./dist/sources/sourcify.d.ts",
      "import": "./dist/sources/sourcify.js"
    },
    "./sources/proxy": {
      "types": "./dist/sources/proxy.d.ts",
      "import": "./dist/sources/proxy.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test",
    "changeset": "changeset"
  },
  "dependencies": {
    "@1001-digital/proxies": "^0.2.0",
    "@1001-digital/natspec": "^0.1.0",
    "@noble/hashes": "^1.7.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
